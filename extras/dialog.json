      "code": {
        "value": "<style>\n  .lav24-wled-controls {\n    display: grid;\n    grid-template-columns: minmax(170px, 30%) minmax(0, 1fr);\n    align-items: center;\n    gap: 10px 12px;\n    color: var(--lav24-ink, #28354a);\n    font: 600 29px Arial, sans-serif;\n  }\n  .lav24-wled-controls select, .lav24-wled-controls input {\n    width: 100%;\n    height: 64px;\n    min-width: 0;\n    box-sizing: border-box;\n    padding: 5px 12px;\n    border: 1px solid var(--lav24-edge, #e3d8c8);\n    border-radius: 14px;\n    color: inherit;\n    background: var(--lav24-field, #f1ede6);\n    font: 400 28px Arial, sans-serif;\n  }\n  .lav24-wled-controls input[type=color] { width: 128px; cursor: pointer; }\n  .lav24-wled-controls a {\n    grid-column: 1 / -1;\n    justify-self: end;\n    color: var(--lav24-info, #275e94);\n    padding: 7px 0;\n  }\n</style>\n<div id=\"${uuid}\" class=\"lav24-wled-controls\">\n  <label for=\"${uuid}-color\">Цвет</label>\n  <input id=\"${uuid}-color\" type=\"color\" disabled>\n  <label for=\"${uuid}-preset\">Пресет</label>\n  <select id=\"${uuid}-preset\" disabled><option>Загрузка…</option></select>\n  <label for=\"${uuid}-effect\">Эффект</label>\n  <select id=\"${uuid}-effect\" disabled><option>Загрузка…</option></select>\n  <label for=\"${uuid}-palette\">Палитра</label>\n  <select id=\"${uuid}-palette\" disabled><option>Загрузка…</option></select>\n  <a target=\"_blank\" rel=\"noopener noreferrer\" hidden>Расширенные настройки WLED ↗</a>\n</div>\n<script type=\"text/javascript\">\n(() => {\n  const api = window.ihapi;\n  const root = document.getElementById(uuid);\n  if (!api || !root) return;\n\n  const did = '__DEVICE_ID__';\n  const kinds = ['preset', 'effect', 'palette'];\n  const props = [...kinds, 'color', 'wled_controls', 'online', 'segment_available'];\n  const subscriptions = props.map(prop => did + '_' + prop);\n  const values = Object.fromEntries(props.map(prop => [prop, api.deviceValue(did, prop)]));\n  const color = root.querySelector('input');\n  const link = root.querySelector('a');\n  const selects = [...root.querySelectorAll('select')];\n  let catalogValue;\n  let controls = {};\n\n  function refreshChoices() {\n    catalogValue = values.wled_controls;\n    try {\n      controls = JSON.parse(catalogValue) || {};\n    } catch (error) {\n      controls = {};\n    }\n    kinds.forEach((kind, index) => {\n      const entries = Array.isArray(controls[kind]) ? controls[kind] : [];\n      const counts = new Map();\n      for (const [, name] of entries) counts.set(name, (counts.get(name) || 0) + 1);\n      const hint = new Option(entries.length ? 'Выберите…' : 'Список недоступен', '');\n      hint.disabled = true;\n      const options = entries.map(([id, name]) => new Option(\n        counts.get(name) > 1 ? name + ' (#' + id + ')' : name, String(id)\n      ));\n      selects[index].replaceChildren(hint, ...options);\n    });\n    link.hidden = true;\n    link.removeAttribute('href');\n    try {\n      const url = new URL(controls.url);\n      if (['http:', 'https:'].includes(url.protocol) && !url.username && !url.password) {\n        link.href = new URL('/', url).href;\n        link.hidden = false;\n      }\n    } catch (error) {\n      // The link appears when the controller address is available.\n    }\n  }\n\n  function update(data) {\n    for (const prop of props) {\n      const key = did + '_' + prop;\n      if (data && Object.prototype.hasOwnProperty.call(data, key)) values[prop] = data[key];\n    }\n    if (catalogValue !== values.wled_controls) refreshChoices();\n    const online = Number(values.online) === 1;\n    const segment = online && Number(values.segment_available) === 1;\n    if (typeof values.color === 'string' && /^#[0-9a-f]{6}([0-9a-f]{2})?$/i.test(values.color) &&\n        document.activeElement !== color) color.value = values.color.slice(0, 7);\n    color.disabled = !segment;\n    kinds.forEach((kind, index) => {\n      const select = selects[index];\n      select.disabled = !(kind === 'preset' ? online : segment) || select.options.length < 2;\n      const current = String(values[kind]);\n      select.value = [...select.options].some(option => option.value === current) ? current : '';\n    });\n  }\n\n  color.addEventListener('change', () => {\n    const white = /^#[0-9a-f]{8}$/i.test(values.color) ? values.color.slice(7) : '';\n    api.deviceCommand(did, 'color', color.value + white);\n  });\n  kinds.forEach((kind, index) => {\n    selects[index].addEventListener('change', event => {\n      if (event.target.value !== '') api.deviceCommand(did, kind, Number(event.target.value));\n    });\n  });\n  api.addEventListener(uuid, 'data', update);\n  api.addEventListener(uuid, 'destroy', () => api.deviceUnsub(uuid, subscriptions));\n  api.deviceSub(uuid, subscriptions);\n  refreshChoices();\n  update();\n})();\n</script>\n",
