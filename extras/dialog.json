ournal\\\"] :is(.MuiTimelineDot-root,.MuiTimelineConnector-root){background-color:var(--lav24-muted,#536277)}\\n[style*=\\\"--lav24-dialog-check\\\"] :is(.MuiFormControlLabel-label,.MuiTypography-root){font-size:32px!important;color:var(--lav24-ink,#28354a)}\\n[style*=\\\"--lav24-dialog-check\\\"] .MuiCheckbox-root .MuiSvgIcon-root{width:34px;height:34px}\";\n  document.head.appendChild(style);\n})();\n</script>\n<script type=\"text/javascript\">\n(() => {\n  const id = 'lav24-dialog-touch-layout';\n  if (document.getElementById(id)) return;\n  const style = document.createElement('style');\n  style.id = id;\n  style.textContent = \"[style*=\\\"--lav24-touch-check\\\"] .MuiFormControlLabel-root{display:flex!important;justify-content:flex-start!important;width:100%;height:100%;margin:0!important;gap:10px;box-sizing:border-box}\\n[style*=\\\"--lav24-touch-check\\\"] .MuiCheckbox-root{flex:0 0 64px;width:64px;height:64px;padding:0!important}\\n[style*=\\\"--lav24-touch-check\\\"] .MuiCheckbox-root svg{width:42px!important;height:42px!important;font-size:42px!important}\\n[style*=\\\"--lav24-touch-check\\\"] .MuiFormControlLabel-label{font-size:32px!important;line-height:1.1!important}\";\n  document.head.appendChild(style);\n})();\n</script>\n<script type=\"text/javascript\">\n(() => {\n  const id = 'lav24-number-field-layout';\n  if (document.getElementById(id)) return;\n  const style = document.createElement('style');\n  style.id = id;\n  style.textContent = \"[style*=\\\"--lav24-number-field\\\"]:not(input){\\n  display:flex!important;\\n  align-items:center!important;\\n  box-sizing:border-box;\\n}\\n[style*=\\\"--lav24-number-field\\\"] .MuiFormControl-root{\\n  flex:1 1 auto;\\n  width:100%;\\n  min-width:0;\\n  height:auto!important;\\n  justify-content:center;\\n}\\n:is([style*=\\\"--lav24-number-field\\\"],[style*=\\\"--lav24-number-field\\\"] *) .MuiInputBase-root,\\n[style*=\\\"--lav24-number-field\\\"].MuiInputBase-root{\\n  display:flex!important;\\n  width:100%;\\n  min-width:0;\\n  height:auto!important;\\n  align-items:center!important;\\n  margin:0!important;\\n  padding-block:0!important;\\n}\\n[style*=\\\"--lav24-number-field\\\"] input,input[style*=\\\"--lav24-number-field\\\"]{\\n  display:block!important;\\n  box-sizing:border-box!important;\\n  flex:1 1 auto;\\n  min-width:0;\\n  height:48px!important;\\n  min-height:48px!important;\\n  max-height:none!important;\\n  margin:0!important;\\n  padding:0 12px!important;\\n  font-size:34px!important;\\n  line-height:44px!important;\\n  align-self:center!important;\\n}\";\n  document.head.appendChild(style);\n})();\n</script>\n<script type=\"text/javascript\">\n(() => {\n  const id = 'lav24-native-dialog-fit';\n  if (document.getElementById(id)) return;\n\n  const style = document.createElement('style');\n  style.id = id;\n  style.textContent = '.ihdialog > .dialog[data-lav24-fit]{flex:none;zoom:var(--lav24-dialog-scale)}'\n    + '.ihdialog > .dialog [style*=\"--lav24-dialog-journal\"],.ihdialog > .dialog [style*=\"--lav24-dialog-journal\"] *{overscroll-behavior:contain}';\n  document.head.appendChild(style);\n\n  let frame = 0;\n  function fitDialogs() {\n    frame = 0;\n    const viewport = document.documentElement;\n    for (const dialog of document.querySelectorAll('.ihdialog > .dialog:has(> [style*=\"--lav24-paper\"])')) {\n      const width = parseFloat(dialog.style.width);\n      const height = parseFloat(dialog.style.height);\n      if (!(width > 0 && height > 0 && viewport.clientWidth > 24 && viewport.clientHeight > 24)) continue;\n      const scale = Math.min(1, (viewport.clientWidth - 24) / width, (viewport.clientHeight - 24) / height);\n      if (scale < 1) {\n        dialog.style.setProperty('--lav24-dialog-scale', String(scale));\n        dialog.setAttribute('data-lav24-fit', '');\n      } else {\n        dialog.style.removeProperty('--lav24-dialog-scale');\n        dialog.removeAttribute('data-lav24-fit');\n      }\n    }\n  }\n\n  function schedule() {\n    if (!frame) frame = requestAnimationFrame(fitDialogs);\n  }\n\n  new MutationObserver(schedule).observe(document.body, {childList: true, subtree: true});\n  window.addEventListener('resize', schedule, {passive: true});\n  schedule();\n})();\n</script>",
